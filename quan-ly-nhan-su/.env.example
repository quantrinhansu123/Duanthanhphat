NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Khóa toàn bộ ứng dụng bằng HTTP Basic Auth. Hai biến phải được cấu hình cùng nhau.
APP_BASIC_AUTH_USER=
APP_BASIC_AUTH_PASSWORD=

# Google Drive lưu tài liệu PDF. Luôn cần ID thư mục đích.
GOOGLE_DRIVE_FOLDER_ID=

# OAuth tài khoản Google cá nhân: dùng được thư mục trong My Drive.
# Chạy `pnpm google-drive:oauth` sau khi điền Client ID và Client Secret.
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=

# Phương án thay thế: Service Account chỉ dùng với thư mục trong Shared Drive.
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_SHARED_DRIVE_ID=

# Cloudinary lưu ảnh chứng chỉ và đào tạo.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
