NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Khóa toàn bộ ứng dụng bằng HTTP Basic Auth. Hai biến phải được cấu hình cùng nhau.
APP_BASIC_AUTH_USER=
APP_BASIC_AUTH_PASSWORD=

# Google Drive lưu tài liệu PDF. Luôn cần ID thư mục đích.
GOOGLE_DRIVE_FOLDER_ID=

# OAuth tài khoản Google cá nhân: dùng được thư mục trong My Drive.
# Chạy `pnpm google-drive:oauth` sau khi điền Client ID và Client Secret.
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=

# Phương án thay thế: Service Account chỉ dùng với thư mục trong Shared Drive.
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_SHARED_DRIVE_ID=

# Cloudinary lưu ảnh chứng chỉ và đào tạo.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Zalo OA — gửi "Cấp dầu" cho Chỉ huy trưởng và quản trị viên. Để trống thì chỉ báo trên chuông app.
ZALO_OA_ACCESS_TOKEN=
ZALO_COMMANDER_USER_IDS=
ZALO_ADMIN_USER_IDS=

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# AppSheet: cần khi đẩy file scan BBNT sang bảng lưu trữ AppSheet.
APPSHEET_APP_ID=
APPSHEET_API_KEY=
APPSHEET_APP_NAME=
APPSHEET_TABLE=

# Chatbot cục bộ: codex hoặc anti. Để trống để dùng Gemini API.
CHAT_PROVIDER=codex
CODEX_MODEL=gpt-6-luna
CODEX_EFFORT=medium
# Thư mục hồ sơ hợp đồng riêng trên máy chạy server; không đưa hồ sơ vào Git.
# Để trống dùng đường dẫn tương thích máy cũ: E:\20. Hồ sơ phục vụ AI_QS
CHAT_CONTRACT_DIR=

# Chatbot AI — khóa Gemini lấy tại https://aistudio.google.com/apikey (chỉ dùng ở server).
GEMINI_API_KEY=
# Tùy chọn, mặc định gemini-3.8-flash.
GEMINI_MODEL=

# Kho hồ sơ ETL, dữ kiện có duyệt và tra cứu theo quyền từng kho.
# Chạy migration_20261116_document_knowledge.sql trước khi bật.
DOCUMENT_KNOWLEDGE_ENABLED=false
# Dùng GEMINI_API_KEY ở trên; không cần chạy model embedding trên máy.
KNOWLEDGE_EXTRACT_MODEL=gemini-3.5-flash-lite
KNOWLEDGE_EMBEDDING_MODEL=gemini-embedding-001
# gemini: đọc lớp chữ trước, dùng API cho trang scan; paddle: OCR CPU nếu đã cài PaddleOCR.
KNOWLEDGE_OCR=gemini
KNOWLEDGE_MAX_PAGES=250
KNOWLEDGE_PYTHON=python
# Chỉ những UUID hoặc email được liệt kê mới nhập thư mục CHAT_CONTRACT_DIR qua giao diện.
KNOWLEDGE_LOCAL_SCAN_USERS=
# Nếu chỉ có codex.cmd trên PATH Windows, điền đường dẫn đầy đủ tới codex.exe.
KNOWLEDGE_CODEX_BINARY=
KNOWLEDGE_CODEX_MODEL=gpt-6-luna
# Để trống để CLI dùng CODEX_HOME hiện tại hoặc ~/.codex; giữ đăng nhập trên server.
KNOWLEDGE_CODEX_HOME=
# Optional persistent OCR/extraction/vector checkpoints. Default .codex-chat/knowledge-cache (private).
KNOWLEDGE_CACHE_DIR=
# Full server-access legacy CLI is disabled except for explicitly trusted administrator UUIDs/emails.
# Leave empty for all users to use scoped knowledge tools or bounded general chat.
CHAT_LEGACY_ADMIN_IDS=
